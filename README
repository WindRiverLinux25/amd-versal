	oe-core
	wrlinux
	meta-xilinx/meta-xilinx-core
	meta-xilinx/meta-xilinx-standalone
	meta-xilinx/meta-xilinx-standalone-sdt
	meta-xilinx/meta-microblaze
	meta-arm/meta-arm
	meta-amd-adaptive-socs/meta-amd-adaptive-socs-bsp

